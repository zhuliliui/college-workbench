<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件布局 v5：仿系统待办样式 —— 标题 + 右上角「任务 N · DDL M」计数 + 可滚动任务列表（ListView，点击直接勾选）+ 底部余额与＋
     整块组件点击打开 App（任务行/＋ 的点击优先级更高，不受影响）
     2026-09-28：固定 7 行改 ListView，小组件也能看到全部任务与 DDL -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cw_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/cw_widget_bg"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/cw_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="今日计划"
            android:textSize="19sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/cw_task_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="任务"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/cw_task_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="34sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/cw_sep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="·"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/cw_ddl_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DDL"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/cw_ddl_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="34sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <ListView
        android:id="@+id/cw_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none"
        android:cacheColorHint="@android:color/transparent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="5dp">

        <TextView
            android:id="@+id/cw_piggy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="17sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/cw_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="＋"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp" />
    </LinearLayout>
</LinearLayout>
