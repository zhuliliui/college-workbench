<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件布局：标题行（今日计划 · DDL + 存钱罐余额）+ 最多 6 行内容 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cw_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/cw_widget_bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/cw_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🚜 今日计划 · DDL"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/cw_piggy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:singleLine="true"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView android:id="@+id/cw_row0" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:singleLine="true" android:ellipsize="end" android:layout_marginTop="7dp" />
    <TextView android:id="@+id/cw_row1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:singleLine="true" android:ellipsize="end" android:layout_marginTop="5dp" />
    <TextView android:id="@+id/cw_row2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:singleLine="true" android:ellipsize="end" android:layout_marginTop="5dp" />
    <TextView android:id="@+id/cw_row3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:singleLine="true" android:ellipsize="end" android:layout_marginTop="5dp" />
    <TextView android:id="@+id/cw_row4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:singleLine="true" android:ellipsize="end" android:layout_marginTop="5dp" />
    <TextView android:id="@+id/cw_row5" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:singleLine="true" android:ellipsize="end" android:layout_marginTop="5dp" />
</LinearLayout>
